{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workspace records RecordSet v1",
  "type": "object",
  "required": ["schema_version", "project_id", "control", "version", "records", "events", "journal", "attachments"],
  "properties": {
    "schema_version": {"const": 1},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "control": {"type": "object", "required": ["mode", "phase", "epoch", "policy_version"]},
    "version": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {"type": "object", "required": ["record_id", "kind", "created_at", "updated_at", "source", "body", "metadata", "relations"]}},
    "events": {"type": "array"},
    "journal": {"type": "array"},
    "attachments": {"type": "array"}
  }
}
