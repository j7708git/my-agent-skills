# 編輯器／作業系統產物
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Python 快取與暫存環境
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/

# 個人設定與本機憑證（.env.example 仍要進版控，供範例用途）
.env
.env.*
!.env.example
*.pem
*.key
!.gitconfig.local

# 掃描輸出與報告（產物，不進版控）
reports/
report/
*-report.json
*-report.txt
*-report.csv
*-report.sarif
gitleaks-report.*
.gitleaks-report.*
.sarif

# 本機工作紀錄與任務 metadata（不屬於公開 repo 內容，整個目錄都不進版控）
# .local/          完整計畫、todo、session 日誌、驗收紀錄、研究筆記、視覺檢查 sidecar
# .openchamber/    PM 派工卡（任務計畫卡）
# 分流規則見 AGENTS.md「文件分流」；公開知識放 docs/。
.local/
.openchamber/

# Archify 視覺檢查 sidecar（截圖與收據含本機絕對路徑，不追蹤；成品 docs/architecture.html 要進版控）
# 產生後請移到 .local/reports/architecture/，避免留在 docs/ 混淆公開文件。
*.visual-check.json
*.visual-check.html
*.visual-check.*.png

# 暫存檔
*.tmp
*.bak
